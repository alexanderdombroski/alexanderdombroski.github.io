{
  "name": "personal-site",
  "type": "module",
  "author": {
    "name": "Alex Dombroski",
    "url": "https://alexdombroski.com"
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.18.0",
      "onFail": "warn"
    }
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint src",
    "check-types": "tsc --noEmit && astro check && svelte-check",
    "test": "vitest",
    "prebuild": "nub scripts/prebuild.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/svelte": "^9.0.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-mdx": "^3.8.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-mdx": "^3.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "octokit": "^5.0.5",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "astro": "^7.3.5",
    "eva-icons": "^1.1.3",
    "p-limit": "^7.3.3",
    "satteri": "^0.10.5",
    "zod": "^4.6.5"
  },
  "bundleDependencies": [
    "eva-icons"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  },
  "allowBuilds": {
    "esbuild": true
  }
