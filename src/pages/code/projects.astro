---
import CodeLayout from '../../layouts/CodeLayout.astro';
import rawProjects from '../../assets/data/projects';
import contributorsData from '../../assets/data/contributors.json';
import ProjectsList from '../../components/pages/projects/ProjectsList.svelte';

const contributors: Record<
  string,
  (typeof contributorsData)[keyof typeof contributorsData]
> = contributorsData;

const projects = rawProjects.map((repo) => {
  const repoContributors = contributors[repo.name];
  const contributorCount = Array.isArray(repoContributors)
    ? repoContributors.length
    : 0;
  return {
    ...repo,
    contributorCount,
    languageNames: repo.langFilterList,
    langFilterList: repo.langFilterList,
  };
});
---

<CodeLayout
  title="Projects"
  description="Browse Alex Dombroski's public GitHub repositories with language filters."
>
  <section class="hero">
    <div class="eyebrow">Code</div>
    <h1>Personal Projects</h1>
    <p>
      A public, accessible view of my GitHub repositories. Filter by language,
      scan the cards, and jump straight to the source.
    </p>
  </section>

  <ProjectsList client:only="svelte" projects={projects} />
</CodeLayout>

<style>
  .hero {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0 1.5rem;
  }

  .eyebrow {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
    color: rgb(var(--gray));
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    max-width: 12ch;
  }

  .hero p {
    max-width: 60ch;
    margin-bottom: 0;
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 1rem;
    }
  }
</style>
