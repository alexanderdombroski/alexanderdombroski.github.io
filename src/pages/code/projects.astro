---
import CodeLayout from '../../layouts/CodeLayout.astro';
import rawProjects from '../../assets/data/projects';
import RepoCard from '../../components/pages/projects/RepoCard.astro';
import contributorsData from '../../assets/data/contributors.json';

const contributors: Record<
  string,
  (typeof contributorsData)[keyof typeof contributorsData]
> = contributorsData;

const projects = rawProjects.map((repo) => {
  const repoContributors = contributors[repo.name];
  const contributorCount = Array.isArray(repoContributors)
    ? repoContributors.length
    : 0;
  return {
    ...repo,
    contributorCount,
    languageNames: repo.languageEntries.length
      ? repo.languageEntries.map(({ name }) => name)
      : repo.language
        ? [repo.language]
        : ['Other'],
  };
});

const initialProjects = projects.filter((repo) => !repo.fork);
const forkProjects = projects.filter((repo) => repo.fork);
const initialLanguages = [
  ...new Set(initialProjects.flatMap((repo) => repo.languageNames)),
].sort((a, b) => a.localeCompare(b));

const visibleProjectCount = initialProjects.length;
---

<CodeLayout
  title="Projects"
  description="Browse Alex Dombroski's public GitHub repositories with language filters."
>
  <section class="hero">
    <div class="eyebrow">Code</div>
    <h1>Personal Projects</h1>
    <p>
      A public, accessible view of my GitHub repositories. Filter by language,
      scan the cards, and jump straight to the source.
    </p>
    <p class="stats" data-filter-status aria-live="polite">
      Showing {visibleProjectCount} repositories
    </p>
  </section>

  <section aria-labelledby="language-filters" class="filters">
    <div class="controls">
      <button
        class="fork-toggle"
        type="button"
        data-forks-toggle
        aria-pressed="false"
      >
        Show forks
      </button>
    </div>

    <div class="section-heading">
      <h2 id="language-filters">Filter by language</h2>
      <p>
        By default, forks are hidden. Turning them on also adds fork-only
        languages to the filter list.
      </p>
    </div>

    <div class="filter-row" data-filter-row>
      <button
        class="filter-button active"
        type="button"
        data-language-filter="all"
        aria-pressed="true"
      >
        All
      </button>
      {
        initialLanguages.map((language) => (
          <button
            class="filter-button"
            type="button"
            data-language-filter={language}
            aria-pressed="false"
          >
            {language}
          </button>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="projects" class="projects">
    <div class="section-heading">
      <h2 id="projects">Repositories</h2>
      <p>Cards stay readable even without JavaScript enabled.</p>
    </div>

    <div class="grid" data-project-grid>
      {initialProjects.map((repo) => <RepoCard repo={repo} />)}
      {
        forkProjects.map((repo) => (
          <template data-fork-card-template data-repo-full-name={repo.fullname}>
            <RepoCard repo={repo} />
          </template>
        ))
      }
    </div>
  </section>
</CodeLayout>

<script>
  import rawProjects from '../../assets/data/projects';
  const repos = rawProjects.map((repo) => ({
    ...repo,
    languageNames: repo.languageEntries.length
      ? repo.languageEntries.map(({ name }) => name)
      : repo.language
        ? [repo.language]
        : ['Other'],
  }));
  const grid = document.querySelector('[data-project-grid]');
  const filterRow = document.querySelector('[data-filter-row]');
  const forksToggle = document.querySelector('[data-forks-toggle]');
  const status = document.querySelector('[data-filter-status]');
  const forkTemplates = new Map(
    Array.from(document.querySelectorAll('[data-fork-card-template]')).map(
      (template) => [
        (template as HTMLDataElement).dataset.repoFullName,
        template,
      ],
    ),
  );
  const cards = new Map(
    Array.from(document.querySelectorAll('[data-repo-card]')).map((card) => [
      (card as HTMLDataElement).dataset.repoFullName,
      card,
    ]),
  );

  let showForks = false;
  let activeLanguage = 'all';

  const normalize = (value: string) => value.toLowerCase();

  const visibleRepos = () => repos.filter((repo) => showForks || !repo.fork);

  const syncForkCards = () => {
    if (!grid) return;

    for (const repo of repos) {
      if (!repo.fork) continue;

      const existingCard = cards.get(repo.fullname);

      if (!showForks) {
        if (existingCard) {
          existingCard.remove();
          cards.delete(repo.fullname);
        }
        continue;
      }

      if (existingCard) continue;

      const template = forkTemplates.get(repo.fullname);
      // @ts-ignore
      const card = template?.content.firstElementChild?.cloneNode(true);

      if (!(card instanceof HTMLElement)) continue;

      grid.appendChild(card);
      cards.set(repo.fullname, card);
    }
  };

  const availableLanguages = () => {
    const languages = new Set<string>();

    for (const repo of visibleRepos()) {
      for (const language of repo.languageNames) {
        languages.add(language);
      }
    }

    return [...languages].sort((a, b) => a.localeCompare(b));
  };

  const renderFilters = () => {
    if (!filterRow) return;

    const languages = availableLanguages();
    const activeKey = normalize(activeLanguage);
    const buttons = [
      `<button class="filter-button ${activeLanguage === 'all' ? 'active' : ''}" type="button" data-language-filter="all" aria-pressed="${String(activeLanguage === 'all')}">All</button>`,
      ...languages.map(
        (language) => `
              <button class="filter-button ${normalize(language) === activeKey ? 'active' : ''}" type="button" data-language-filter="${language}" aria-pressed="${String(normalize(language) === activeKey)}">
                ${language}
              </button>
            `,
      ),
    ];

    filterRow.innerHTML = buttons.join('');

    for (const button of Array.from(
      filterRow.querySelectorAll('[data-language-filter]'),
    )) {
      button.addEventListener('click', () => {
        activeLanguage =
          (button as HTMLDataElement).dataset.languageFilter ?? 'all';
        applyFilter();
      });
    }
  };

  const applyFilter = () => {
    syncForkCards();

    const languages = availableLanguages();
    const languageSet = new Set(languages.map(normalize));

    if (
      activeLanguage !== 'all' &&
      !languageSet.has(normalize(activeLanguage))
    ) {
      activeLanguage = 'all';
    }

    let visibleCount = 0;

    for (const repo of repos) {
      const card = cards.get(repo.fullname);
      if (!card) continue;

      const matchesForkMode = showForks || !repo.fork;
      const matchesLanguage =
        activeLanguage === 'all' ||
        repo.languageNames.some(
          (language) => normalize(language) === normalize(activeLanguage),
        );

      const isVisible = matchesForkMode && matchesLanguage;
      card.toggleAttribute('hidden', !isVisible);

      if (isVisible) visibleCount += 1;
    }

    if (status) {
      status.textContent =
        activeLanguage === 'all'
          ? `Showing ${visibleCount} repositories`
          : `Showing ${visibleCount} repositories filtered by ${activeLanguage}`;
    }

    if (forksToggle) {
      forksToggle.textContent = showForks ? 'Hide forks' : 'Show forks';
      forksToggle.setAttribute('aria-pressed', String(showForks));
    }

    renderFilters();
  };

  if (forksToggle) {
    forksToggle.addEventListener('click', () => {
      showForks = !showForks;
      applyFilter();
    });
  }

  applyFilter();
</script>

<style>
  .hero {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0 1.5rem;
  }

  .eyebrow {
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-size: 0.78rem;
    font-weight: 700;
    color: rgb(var(--gray));
  }

  .hero h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    max-width: 12ch;
  }

  .hero p {
    max-width: 60ch;
    margin-bottom: 0;
  }

  .stats {
    font-weight: 600;
    color: rgb(var(--gray-dark));
  }

  .filters,
  .projects {
    margin-top: 2.25rem;
  }

  .section-heading {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .section-heading h2 {
    font-size: 1.45rem;
  }

  .section-heading p {
    margin: 0;
    color: rgb(var(--gray));
  }

  .controls {
    margin-bottom: 1rem;
  }

  .fork-toggle,
  .filter-button {
    appearance: none;
    border: 1px solid rgb(var(--gray-light));
    background: rgba(255, 255, 255, 0.85);
    color: rgb(var(--gray-dark));
    border-radius: 999px;
    padding: 0.55rem 0.95rem;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .fork-toggle:hover,
  .fork-toggle:focus-visible,
  .filter-button:hover,
  .filter-button:focus-visible {
    transform: translateY(-1px);
    box-shadow: var(--box-shadow);
    border-color: rgba(var(--gray), 0.35);
    outline: none;
  }

  .fork-toggle[aria-pressed='true'],
  .filter-button.active {
    background: var(--accent);
    color: white;
    border-color: var(--accent);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.2rem;
  }

  @media (max-width: 720px) {
    .hero {
      padding-top: 1rem;
    }
  }
</style>
